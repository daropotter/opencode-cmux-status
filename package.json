{
  "name": "opencode-cmux-status",
  "version": "0.1.0",
  "description": "OpenCode 2 plugin that surfaces agent activity in the cmux sidebar: status pills, progress, logs and notifications. Fork of opencode-tmux-session-status with the tmux backend replaced by cmux.",
  "license": "MIT",
  "author": "4m1z (original opencode-tmux-session-status), daropotter (cmux adaptation)",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/daropotter/opencode-cmux-status.git"
  },
  "homepage": "https://github.com/daropotter/opencode-cmux-status#readme",
  "bugs": {
    "url": "https://github.com/daropotter/opencode-cmux-status/issues"
  },
  "keywords": [
    "opencode",
    "opencode-plugin",
    "cmux",
    "status",
    "sidebar"
  ],
  "type": "module",
  "main": "./src/index.ts",
  "exports": {
    ".": "./src/index.ts"
  },
  "files": [
    "dist/",
    "src/",
    "README.md",
    "CHANGELOG.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "bun build ./src/index.ts --outdir ./dist --target bun",
    "prepack": "bun run build",
    "typecheck": "tsc --noEmit",
    "test": "bun test",
    "lint": "tsc --noEmit",
    "format:check": "prettier --check src tests README.md CHANGELOG.md package.json tsconfig.json"
  },
  "dependencies": {
    "@opencode/plugin": "^2.0.0"
  },
  "devDependencies": {
    "@types/node": "^26.6.3",
    "bun-types": "^1.4.2",
    "prettier": "^3.6.2",
    "typescript": "^5.9.0"
  }
}
